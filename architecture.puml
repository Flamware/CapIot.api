@startuml
' Set left to right direction for overall layout
left to right direction

skinparam componentStyle uml2
skinparam nodePadding 20
skinparam componentPadding 5
skinparam classAttributeIconSize 0
skinparam nodeMargin 50
skinparam padding 5
skinparam lineThickness 1
skinparam backgroundColor #EEEBD

' Nodes and components
node "Client" {
  component "FrontEnd (Web/Mobile)" as FE
}

node "Auth Service" as AuthS {
    database "User Database" as UserDB
}

node "Google VPS" {
  component "API InfluxDB" as API_InfluxDB
  component "API Backend" as API_Backend

  node "Databases" {
    database "PostgreSQL" as PostgreSQL
    database "InfluxDB" as InfluxDB
  }

  component "MQTT Broker (Mosquitto)" as MQTT_Broker
}

node "STM32 Fleet" {
  component "STM32 Device" as STM32
}

' Relationships
FE --> API_Backend : "Login/Token get"
FE --> API_InfluxDB : "Authenticated Requests"

STM32 --> API_InfluxDB : "Provisioning Request"
STM32 --> MQTT_Broker : "Pub/Sub (User/Pass + SSL)"
STM32 --> API_InfluxDB : "Sensor/Metrics Data"

API_Backend --> AuthS : "User/Device Token Verif."
API_Backend --> PostgreSQL : "Data Storage"
API_Backend --> MQTT_Broker : "Pub/Sub"

API_InfluxDB --> API_Backend : "Token Provisioning\n & Validation"
API_InfluxDB --> InfluxDB : "Time-Series"

' Notes
note right of API_Backend
  1. Auth Service Integration
  2. **Device Provisioning\n& Token Mgmt (via API InfluxDB)**
  3. Device Config/Commands
  4. Data Persist. (User/Site)
end note

note right of API_InfluxDB
  1. **Handles Provisioning & Token Validation**
  2. Data Ingestion
end note

note right of STM32
  1. **Request Provisioning Token\nfrom API InfluxDB**
  2. Data Publish (HTTP/MQTT)
end note

note left of FE
  1. Login to API Backend
  2. Get Auth Token
  3. Use Token for all API calls
end note

note bottom of PostgreSQL
  User/Site Data
  Device/Location Config
end note

note bottom of InfluxDB
  Sensor & Metrics Data
end note
@enduml