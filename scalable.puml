@startuml
' Frontend Deployment with NodePort Service and LoadBalancer Ingress
left to right direction

skinparam componentStyle uml2
skinparam backgroundColor #EEEBD

cloud "Kubernetes Cluster: capiot-cluster" {

    node "Namespace: capiot" {

        node "API/UI Load Balancer" {
            component "Ingress Controller" {
                component "Ingress (UI/API/InfluxDB)" as Ingress_API_UI
            }
        }

        node "Frontend Exposure" {
            component "Frontend NodePort Service" as FE_Service
        }

        node "Frontend Deployment" {
            component "frontend-deployment Pod (2/2)" as FE_Pod
        }
    }
}

' Relationships
Ingress_API_UI --> FE_Service : "External Traffic (e.g., HTTP/S)"
FE_Service --> FE_Pod : "Redirects Traffic (NodePort)"

' Notes
note right of FE_Service
  Type: NodePort
  Exposes Frontend Pods
  on each Node's IP at a
  static port.
end note

note right of Ingress_API_UI
  Routes external traffic
  to the Frontend Service
  based on Ingress rules.
end note

note bottom of FE_Pod
  Docker Image:
  <Public Docker Image Name>

  Environment Variables:
  - API_URL: <Your API Backend URL>
  - INFLUXDB_API_URL: <Your InfluxDB API URL>
end note

@enduml
