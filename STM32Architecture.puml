@startuml
left to right direction

skinparam componentStyle uml2

node "Client" {
  component "Frontend (Web/Mobile)" as FE
}

cloud "Auth0 (Authentication Only)" as Auth0

node "Backend (GraphQL + JWT Provider)" as Backend {
  component "Auth Middleware" as AuthMiddleware
  component "API Backend" as API_Backend
  database "PostgreSQL (Users, JWT Sessions)" as PostgreSQL
}

node "Fleet of STM32s" {
  component "STM32 Device" as STM32
}

FE --> Backend : "Login Request"
Backend --> Auth0 : "Auth Verification"
Auth0 --> Backend : "Returns Auth0 Token"
Backend --> Backend : "Generate JWT Custom"
Backend --> PostgreSQL : "Store JWT Session"
Backend --> FE : "Return JWT Custom"

FE --> API_Backend : "Use Custom JWT for API Calls"
API_Backend --> PostgreSQL : "Check JWT Validity"
STM32 --> API_Backend : "Use Custom Device Token"

@enduml
